PORT=4000
META_VERIFY_TOKEN=replace-with-a-random-verification-string
META_APP_ID=replace-with-your-meta-app-id
META_APP_SECRET=replace-with-your-meta-app-secret
META_USER_ACCESS_TOKEN=replace-with-a-long-lived-user-access-token
META_PAGE_ACCESS_TOKEN=replace-with-a-page-access-token
META_LEADGEN_FORM_ID=replace-with-the-page-lead-form-id
META_GRAPH_API_VERSION=v26.0
# Recommended for this PoC: the test Page has no Instant Form, and creating one requires a verified Business Portfolio.
META_GRAPH_API_MOCK=true
NGROK_DOMAIN=dreamily-speech-unaudited.ngrok-free.dev
NGROK_AUTH_TOKEN=replace-with-your-ngrok-authtoken
